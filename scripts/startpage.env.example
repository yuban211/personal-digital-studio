# 起始页 V2 —— 服务器运行配置模板
# 用法：cp scripts/startpage.env.example scripts/startpage.env，填好密钥后
#       source scripts/startpage.env
#
# 注意：scripts/startpage.env 含真实密钥，已被 .gitignore 排除，切勿提交。

# Caddy 用的是 `handle /studio/*`（不剥前缀），所以应用必须自己带 /studio 前缀。
# 若哪天改成 handle_path（剥前缀），这里改回 "" 即可 —— app.py 两种都挂了静态。
export APP_PREFIX="/studio"
export HOST="127.0.0.1"
export PORT="9103"

# 数据与静态资源（容器里 newtab/ 是 root 只读，放可写目录）
export DATA_DIR="/workspace/startpage-db"
export STUDIO_DB="/workspace/startpage-db/startpage.db"
export STUDIO_BACKUP_DIR="/workspace/startpage-db/backups"

# 同步令牌：留空则 /api/config 完全开放（任何人可写）。
# 前端目前不调用该接口，故默认关死写入。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
export SYNC_TOKEN="<填入随机值>"

export COOKIE_SECURE="1"
# 生产必须显式提供，缺失时 src/config.py 直接拒绝启动。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
export APP_SECRET="<填入随机值>"

export PYTHONPATH="/workspace/startpage/src"
export PYTHONUNBUFFERED="1"
