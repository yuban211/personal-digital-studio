# Copy to .env only for local configuration; do not commit .env.
APP_PREFIX=/studio
HOST=127.0.0.1
PORT=8000
# Replace with a long random value before any non-local deployment.
APP_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0
# Optional: absolute public origin used by sitemap and RSS.
PUBLIC_BASE_URL=http://localhost:8000
