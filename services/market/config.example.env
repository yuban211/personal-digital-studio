# 行情数据服务 —— 运行配置示例
# 复制成 market.env 后按需修改；start 脚本会 source 它。

# ── 监听 ──
MARKET_HOST="127.0.0.1"
MARKET_PORT="9110"

# ── 事件总线 ──
# auto：REDIS_URL 非空用 Redis，否则进程内广播（单实例推荐）
# redis：强制 Redis（多机部署时用）
MARKET_BUS="auto"
# REDIS_URL="redis://127.0.0.1:6379/0"

# ── 实时行情采集 ──
# 自选池，逗号分隔。格式：600519.SH / 000858.SZ / 430047.BJ
TDX_SYMBOLS="600519.SH,000858.SZ,300750.SZ,601318.SH"
# worker 数 = 并发连接数。每 worker 独占一个连接，标的池轮转分片
TDX_WORKERS="2"
# 轮询间隔（秒）。免费节点别调太密，<3 秒容易被限流踢下线
TDX_POLL_INTERVAL="3"
# 协议：mac（MAC 二进制，刷新更快，推荐）/ std（标准 7709）
TDX_PROTOCOL="mac"
# 单批最大标的数（通达信上限 80）
TDX_BATCH_SIZE="80"

# ── 历史数据湖（CNEquity）──
# 对应：cne config create --data-root <该路径> && cne init
CNE_LAKE_ROOT="D:/cnequity"

# ── 鉴权 ──
# 留空＝不鉴权（仅限内网）；公网暴露务必设
API_TOKEN=""
# 快照超过该秒数视为陈旧，/api/quotes 返回 503
MARKET_STALE_AFTER="15"

# ── 跨域 ──
# 起始页要调用就写它的来源，例如 https://yuban211.duckdns.org:59684
CORS_ORIGINS="*"
LOG_LEVEL="INFO"
