{
  "manifest_version": 3,
  "name": "起始页",
  "version": "2.0.0",
  "description": "轻量浏览器起始页：搜索、快捷入口、时间天气、待办。数据存在本地。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "offline_enabled": true,
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
